{
  "name": "shipledger",
  "version": "0.2.0",
  "description": "Reconcile a claimed release changeset against local git history",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shipledger": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "build-info.json"
  ],
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.9.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:10})\"",
    "build": "npm run clean && node scripts/write-build-info.mjs && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
